# Скопіюйте в .env та заповніть значеннями
# cp .env.example .env

# Facebook / Meta Ads
FACEBOOK_ACCESS_TOKEN=your_long_lived_access_token
FACEBOOK_AD_ACCOUNT_ID=act_123456789

# Google Ads (потрібен OAuth2 refresh token)
GOOGLE_DEVELOPER_TOKEN=your_developer_token
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REFRESH_TOKEN=xxx
GOOGLE_CUSTOMER_ID=1234567890

# TikTok Ads
TIKTOK_ACCESS_TOKEN=your_access_token
TIKTOK_ADVERTISER_ID=1234567890123456789
